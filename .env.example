# Export the values you need into the process environment.
# The application does not auto-load .env; source an ignored local file yourself if desired.

MOI_ENVIRONMENT=development
MOI_DATABASE_PATH=var/manufacturing_operations_intelligence.db
MOI_AI_ENABLED=false
MOI_PUBLIC_DEMO=false

# Public portfolio deployment: use an ephemeral writable location and synthetic data only.
# MOI_ENVIRONMENT=public-demo
# MOI_DATABASE_PATH=/tmp/manufacturing-operations-intelligence-demo.sqlite3
# MOI_PUBLIC_DEMO=true

# Optional OpenAI Responses summary. AI runs only after the user requests a draft.
# Set the key in your shell or ignored .env; this project does not auto-load .env.
MOI_AI_API_KEY=
MOI_AI_MODEL=gpt-4.1-mini
